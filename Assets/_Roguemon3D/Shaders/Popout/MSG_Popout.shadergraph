{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "346fd9acbe414b349684e497e7563c13",
    "m_Title": "Parallax Occlusion Mapping",
    "m_Content": "Parallax Occlusion Mapping samples a height map multiple times (based on the number of Steps) in a path along the view vector and reconstructs the scene depth of the surface. It uses this depth information to derive UV coordinates for sampling the textures. This process is expensive, but can be made cheaper by using the method to the left which controls the number of steps based on distance and camera angle.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -674.0,
        "y": 1222.0,
        "width": 380.0,
        "height": 116.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

