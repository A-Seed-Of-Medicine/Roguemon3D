{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3ed4d38f359449eaa07bca6c5819d400",
    "m_Title": "Parallax Mapping",
    "m_Content": "Parallax Mapping samples a height map and then uses the value to offset the UV coordinates based on their height relative to the view direction.",
    "m_TextSize": 0,
    "m_Theme": 0,
